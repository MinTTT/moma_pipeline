# Runs and tests -- not versioned
# ---------------------------------------------------------------------------
runs/
**/runs/
outputs/
wandb/
mlruns/
lightning_logs/
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Development run outputs (images, exported data, logs)
scripts_dev/_sandbox/
scripts_dev/integration_channel_gate/

